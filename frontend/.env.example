# 地図表示用（Maps JavaScript API）。Google Console で HTTP リファラー制限をかけること
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 検索 API のベース URL
# ローカル: http://localhost:8787（backend を bun run dev で起動）
# 本番:     https://durian-map-api.dailyreading.workers.dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# 共有URLの土台（Web を本番デプロイしたらその URL を入れる）
# 未設定なら iOS では Google マップの URL を共有する
NEXT_PUBLIC_WEB_BASE_URL=
