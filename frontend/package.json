{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "NEXT_PUBLIC_API_BASE_URL=https://durian-map-api.dailyreading.workers.dev next build",
    "deploy": "bun run build:prod && wrangler pages deploy out --project-name durian-map --branch main",
    "build:ios": "NEXT_PUBLIC_WEB_BASE_URL=${NEXT_PUBLIC_WEB_BASE_URL:-https://durian-map.pages.dev} bun run build:prod && cap sync ios",
    "ios": "cap open ios",
    "ios:assets": "node scripts/gen-ios-assets.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor/core": "^8",
    "@capacitor/geolocation": "^8",
    "@capacitor/ios": "^8",
    "@capacitor/preferences": "^8",
    "@capacitor/share": "^8",
    "@capacitor/splash-screen": "^8",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@vis.gl/react-google-maps": "^1.7.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3",
    "@capacitor/cli": "^8",
    "@img/sharp-darwin-arm64": "^0.35.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.54.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
